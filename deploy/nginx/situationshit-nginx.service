[Unit]
Description=SituationSHIT static demo via Nginx (port 8080)
After=network.target

[Service]
Type=forking
PIDFile=/run/nginx-situationshit.pid
ExecStartPre=/usr/sbin/nginx -t -c /etc/nginx/situationshit/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/nginx/situationshit/nginx.conf
ExecReload=/usr/sbin/nginx -s reload -c /etc/nginx/situationshit/nginx.conf
ExecStop=/bin/kill -s QUIT $MAINPID
TimeoutStopSec=10
Restart=on-failure
PrivateTmp=true

[Install]
WantedBy=multi-user.target
