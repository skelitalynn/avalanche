[Unit]
Description=SituationSHIT Fuji static site and API proxy
After=network.target situationshit-fuji-api.service
[Service]
Type=forking
PIDFile=/run/nginx-situationshit-fuji.pid
ExecStartPre=/usr/sbin/nginx -t -c /etc/situationshit-fuji/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/situationshit-fuji/nginx.conf
ExecReload=/usr/sbin/nginx -s reload -c /etc/situationshit-fuji/nginx.conf
ExecStop=/bin/kill -s QUIT $MAINPID
Restart=on-failure
PrivateTmp=true
[Install]
WantedBy=multi-user.target
