# Keep the shipped demo in mock mode unless an API implementing spec/contracts.md is running.
VITE_DATA_MODE=mock
VITE_API_BASE_URL=/api/v1
# Optional: select one relationship instead of the first item returned by GET /situations.
VITE_SITUATION_ADDRESS=
# Development-only Vite proxy target; do not put secrets in VITE_* variables.
API_PROXY_TARGET=http://127.0.0.1:3000
