# mvp:local generates its own configuration; no .env is needed.
# For standalone API, Node can load this file explicitly with --env-file.
# API: generate locally; never prefix with VITE_ or commit a real key.
DATA_ENCRYPTION_KEY=
DATABASE_PATH=.local/situationshit.sqlite
APP_ORIGIN=http://localhost:5173
API_PORT=3001
DEPLOYMENT_FILE=.local/deployment-31337.json
# Optional Core Mobile connector (project-owned public project ID).
VITE_WALLETCONNECT_PROJECT_ID=
# Fuji deployment only, after explicit authorization and test AVAX funding.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
DEPLOYER_PRIVATE_KEY=
CONFIRM_FUJI_DEPLOY=no

# Browser build flags; build:local supplies these automatically.
VITE_DEFAULT_MODE=mock
VITE_LOCAL_WALLETS=false
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545

# Optional T018 read-only HTTP/SIWE adapter for the seven-page demo.
VITE_DATA_MODE=mock
VITE_API_BASE_URL=/api/v1
VITE_SITUATION_ADDRESS=
# Development-only Vite proxy target; do not put secrets in VITE_* variables.
API_PROXY_TARGET=http://127.0.0.1:3001
